acl corpnets {
    127.0.0.0/8;
    192.168.42.0/23;
	172.17.0.0/16;
};

options {
	directory "/var/cache/bind";

	forwarders {
{% for i in dns_forwarders %}
	 	{{i}};
{% endfor %}
	};

	dnssec-validation no;
};

statistics-channels {
  inet 127.0.0.1 port 8053 allow { 127.0.0.1; };
};

key "transfer." {
	algorithm hmac-sha256;
	secret "{{ dns_transfer_key }}";
};
key "nsupdate." {
	algorithm hmac-sha256;
	secret "{{ nsupdate_key }}";
};
